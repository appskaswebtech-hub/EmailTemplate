# MySQL connection string used by Prisma
DATABASE_URL="mysql://user:password@localhost:3306/kaswebtech_feedback"

# Gmail SMTP used to send transactional feedback-request emails.
# SMTP_PASS must be a Gmail "App Password" (myaccount.google.com/apppasswords),
# not your normal Gmail password — Gmail requires 2-Step Verification to be on
# before it will let you create one.
SMTP_USER="youraddress@gmail.com"
SMTP_PASS="your16charapppassword"
# Optional: defaults to SMTP_USER if unset
EMAIL_FROM="Kaswebtech <youraddress@gmail.com>"

# NextAuth (admin dashboard login)
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"

# Public base URL of this deployed app. Used to build feedback links sent by email
# and to reference static email assets (must be a publicly reachable URL in production).
APP_BASE_URL="http://localhost:3000"

# Shown in the email footer
COMPANY_NAME="Kaswebtech"

# Used only by prisma/seed.ts to create the first admin user and the WishKeeper application
SEED_ADMIN_EMAIL="admin@kaswebtech.com"
SEED_ADMIN_PASSWORD="change-me-now"
SEED_ADMIN_NAME="Kaswebtech Admin"

# scripts/send-csv.ts reads per-app API keys from scripts/app-keys.json (copy
# scripts/app-keys.example.json and fill in each app's key from /admin/applications) —
# not from an env var, since a CSV can span multiple apps at once.
